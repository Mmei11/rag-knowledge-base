POSTGRES_DB=rag_kb
POSTGRES_USER=rag_user
POSTGRES_PASSWORD=rag_password

SERVER_PORT=8080
FRONTEND_PORT=5175

JWT_SECRET=replace-with-a-long-random-secret-at-least-32-chars
JWT_EXPIRATION_SECONDS=86400

DOCUMENT_STORAGE_DIR=/app/storage/documents
UPLOAD_MAX_FILE_SIZE=10MB
UPLOAD_MAX_REQUEST_SIZE=10MB
DOCUMENT_MAX_SIZE_BYTES=10485760

EMBEDDING_PROVIDER=mock
EMBEDDING_DIMENSION=1024
CHAT_MODEL_PROVIDER=mock
CHAT_MODEL_NAME=mock-chat-model
CHAT_MODEL_TEMPERATURE=0.2

# Set providers to openai to call the real OpenAI API.
# Keep this value empty in committed files. Put the real key in local .env only.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_CHAT_MODEL=gpt-5-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Set providers to qwen to call Alibaba Cloud Model Studio / DashScope.
# Keep this value empty in committed files. Put the real key in local .env only.
QWEN_API_KEY=
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
QWEN_CHAT_MODEL=qwen-plus
QWEN_EMBEDDING_MODEL=qwen3.7-text-embedding-flash
# qwen3.7-text-embedding-flash supports up to 20 texts per request.
QWEN_EMBEDDING_BATCH_SIZE=20
# Keep this modest to balance speed against the model's rate limit.
QWEN_EMBEDDING_CONCURRENCY=3

# Cross-Encoder rerank. Set RERANK_PROVIDER=none to keep the current RRF order.
# Verified DashScope rerank models: qwen3-rerank, gte-rerank-v2, qwen3-vl-rerank.
RERANK_PROVIDER=none
RERANK_ENDPOINT=https://dashscope.aliyuncs.com/api/v1/services/rerank/text-rerank/text-rerank
RERANK_MODEL=qwen3-rerank
# Leave empty to reuse QWEN_API_KEY.
RERANK_API_KEY=
RERANK_CANDIDATE_LIMIT=30
RERANK_TIMEOUT_MS=3000
RERANK_MAX_DOCUMENT_CHARS=2000

CHAT_RATE_LIMIT_ENABLED=true
CHAT_RATE_LIMIT_LIMIT=20
CHAT_RATE_LIMIT_WINDOW_SECONDS=60

VITE_API_BASE_URL=http://localhost:8080
