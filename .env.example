POSTGRES_DB=rag_kb
POSTGRES_USER=rag_user
POSTGRES_PASSWORD=rag_password

SERVER_PORT=8080
FRONTEND_PORT=5173

JWT_SECRET=replace-with-a-long-random-secret-at-least-32-chars
JWT_EXPIRATION_SECONDS=86400

DOCUMENT_STORAGE_DIR=/app/storage/documents
UPLOAD_MAX_FILE_SIZE=10MB
UPLOAD_MAX_REQUEST_SIZE=10MB
DOCUMENT_MAX_SIZE_BYTES=10485760

EMBEDDING_PROVIDER=mock
EMBEDDING_DIMENSION=384
CHAT_MODEL_PROVIDER=mock
CHAT_MODEL_NAME=mock-chat-model
CHAT_MODEL_TEMPERATURE=0.2

CHAT_RATE_LIMIT_ENABLED=true
CHAT_RATE_LIMIT_LIMIT=20
CHAT_RATE_LIMIT_WINDOW_SECONDS=60

VITE_API_BASE_URL=http://localhost:8080
